<Window x:Class="PdfToolPlatform.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF工具平台(內部使用 / 純本機處理)" Height="620" Width="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" FontSize="12" Foreground="Gray"
                   Text="所有檔案處理均在本機完成,不會上傳、不呼叫任何雲端服務。" />

        <TabControl Grid.Row="1">

            <!-- 合併 -->
            <TabItem Header="合併">
                <StackPanel Margin="12">
                    <Button Content="加入PDF檔案..." Width="140" HorizontalAlignment="Left" Click="OnMergeAddFiles" />
                    <ListBox x:Name="MergeFileList" Height="260" Margin="0,8,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="上移" Width="70" Click="OnMergeMoveUp" />
                        <Button Content="下移" Width="70" Margin="6,0,0,0" Click="OnMergeMoveDown" />
                        <Button Content="移除" Width="70" Margin="6,0,0,0" Click="OnMergeRemove" />
                    </StackPanel>
                    <Button Content="合併並儲存..." Width="140" HorizontalAlignment="Left" Click="OnMergeExecute" />
                    <TextBlock x:Name="MergeStatus" Margin="0,8,0,0" Foreground="Green" />
                </StackPanel>
            </TabItem>

            <!-- 分割 -->
            <TabItem Header="分割">
                <StackPanel Margin="12">
                    <Button Content="選擇PDF檔案..." Width="140" HorizontalAlignment="Left" Click="OnSplitSelectFile" />
                    <TextBlock x:Name="SplitFileLabel" Margin="0,6,0,12" Text="(尚未選擇檔案)" />

                    <RadioButton x:Name="SplitModeFixed" Content="依固定頁數拆分" IsChecked="True" GroupName="SplitMode" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,12">
                        <TextBlock Text="每份頁數:" VerticalAlignment="Center" />
                        <TextBox x:Name="SplitPagesPerFile" Width="60" Margin="6,0,0,0" Text="1" />
                    </StackPanel>

                    <RadioButton x:Name="SplitModeRange" Content="依頁碼範圍拆分(例:1-3,4-10,11-12)" GroupName="SplitMode" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,12">
                        <TextBlock Text="範圍:" VerticalAlignment="Center" />
                        <TextBox x:Name="SplitRanges" Width="300" Margin="6,0,0,0" />
                    </StackPanel>

                    <Button Content="選擇輸出資料夾並執行..." Width="180" HorizontalAlignment="Left" Click="OnSplitExecute" />
                    <TextBlock x:Name="SplitStatus" Margin="0,8,0,0" Foreground="Green" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>

            <!-- 浮水印 -->
            <TabItem Header="浮水印">
                <StackPanel Margin="12">
                    <Button Content="選擇PDF檔案..." Width="140" HorizontalAlignment="Left" Click="OnWatermarkSelectFile" />
                    <TextBlock x:Name="WatermarkFileLabel" Margin="0,6,0,12" Text="(尚未選擇檔案)" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="文字內容:" VerticalAlignment="Center" Margin="0,4" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="WatermarkText" Text="機密文件-僅供內部使用" Margin="0,4" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="透明度(0-1):" VerticalAlignment="Center" Margin="0,4" />
                        <Slider Grid.Row="1" Grid.Column="1" x:Name="WatermarkOpacity" Minimum="0.05" Maximum="1.0" Value="0.25" Margin="0,4" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="旋轉角度:" VerticalAlignment="Center" Margin="0,4" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="WatermarkRotation" Text="45" Margin="0,4" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="分布方式:" VerticalAlignment="Center" Margin="0,4" />
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="WatermarkLayoutCombo" Margin="0,4" SelectedIndex="1">
                            <ComboBoxItem Content="置中單一" />
                            <ComboBoxItem Content="斜角單一" />
                            <ComboBoxItem Content="滿版平舖" />
                        </ComboBox>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="平舖間距(X/Y):" VerticalAlignment="Center" Margin="0,4" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <TextBox x:Name="WatermarkSpacingX" Width="70" Text="220" />
                            <TextBlock Text="  x  " VerticalAlignment="Center" />
                            <TextBox x:Name="WatermarkSpacingY" Width="70" Text="160" />
                        </StackPanel>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="起始位置偏移(X/Y,pt):" VerticalAlignment="Center" Margin="0,4" />
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <TextBox x:Name="WatermarkOffsetX" Width="70" Text="0" />
                            <TextBlock Text="  x  " VerticalAlignment="Center" />
                            <TextBox x:Name="WatermarkOffsetY" Width="70" Text="0" />
                        </StackPanel>
                    </Grid>

                    <Button Content="套用並另存..." Width="140" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnWatermarkExecute" />
                    <TextBlock x:Name="WatermarkStatus" Margin="0,8,0,0" Foreground="Green" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>

            <!-- 轉圖檔 -->
            <TabItem Header="轉圖檔">
                <StackPanel Margin="12">
                    <Button Content="選擇PDF檔案..." Width="140" HorizontalAlignment="Left" Click="OnToImageSelectFile" />
                    <TextBlock x:Name="ToImageFileLabel" Margin="0,6,0,12" Text="(尚未選擇檔案)" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="DPI:" VerticalAlignment="Center" />
                        <TextBox x:Name="ToImageDpi" Width="60" Margin="6,0,0,0" Text="150" />
                        <TextBlock Text="格式:" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <ComboBox x:Name="ToImageFormatCombo" Width="80" Margin="6,0,0,0" SelectedIndex="0">
                            <ComboBoxItem Content="PNG" />
                            <ComboBoxItem Content="JPEG" />
                        </ComboBox>
                    </StackPanel>

                    <Button Content="選擇輸出資料夾並執行..." Width="180" HorizontalAlignment="Left" Click="OnToImageExecute" />
                    <TextBlock x:Name="ToImageStatus" Margin="0,8,0,0" Foreground="Green" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
